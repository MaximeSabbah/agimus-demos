<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="panda">
  <xacro:arg name="arm_id" default="fer"/>
  <xacro:arg name="hand" default="true"/>
  <xacro:arg name="with_sc" default="true"/>
  <xacro:arg name="ee_id" default="franka_hand_with_camera"/>
  <xacro:arg name="use_camera" default="true"/>
  <xacro:include filename="$(find franka_description)/robots/${arm_id}/${arm_id}.urdf.xacro"/>
  <xacro:include filename="$(find agimus_demo_05_pick_and_place)/urdf/support.urdf.xacro"/>

  <xacro:support/>

  <joint name="attach_robot_joint" type="fixed">
    <parent link="robot_attachment_link" />
    <child link="base" />
</joint>
</robot>
