<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="obstacle">
  <material name="blue">
    <color rgba="0.1 0.1 0.8 0.5"/>
  </material>
  <material name="human_obstacle">
    <color rgba="0.1 0.6 1.0 0.6"/>
  </material>

  <link name="obstacle">
    <visual>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.1"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="10.0"/>
      <inertia ixx="1.67" ixy="0" ixz="0" iyy="1.67" iyz="0" izz="1.67"/>
    </inertial>
  </link>

  <!-- Dynamic RT-COSMIK obstacles visualized from TF frames obstacle_0/1/2. -->
  <link name="obstacle_0">
    <visual>
      <geometry>
        <cylinder radius="0.045" length="0.22"/>
      </geometry>
      <material name="human_obstacle"/>
    </visual>
  </link>

  <link name="obstacle_1">
    <visual>
      <geometry>
        <cylinder radius="0.035" length="0.20"/>
      </geometry>
      <material name="human_obstacle"/>
    </visual>
  </link>

  <link name="obstacle_2">
    <visual>
      <geometry>
        <cylinder radius="0.03" length="0.12"/>
      </geometry>
      <material name="human_obstacle"/>
    </visual>
  </link>

</robot>
